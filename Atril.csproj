<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Atril</RootNamespace>
    <!-- The version lives in Directory.Build.props -->
    <Description>EPUB reader with a local library and Synology NAS access.</Description>
  </PropertyGroup>

  <!-- The Windows app (Microsoft Store) is a separate project inside windows/ -->
  <ItemGroup>
    <Compile Remove="windows/**" />
    <Content Remove="windows/**" />
    <None Remove="windows/**" />
    <EmbeddedResource Remove="windows/**" />
  </ItemGroup>

</Project>
