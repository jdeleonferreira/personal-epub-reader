<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Atril</RootNamespace>
    <!-- La versión está en Directory.Build.props -->
    <Description>Lector de libros EPUB con biblioteca local y conexión a Synology.</Description>
  </PropertyGroup>

  <!-- La app de Windows (Microsoft Store) es un proyecto aparte dentro de windows/ -->
  <ItemGroup>
    <Compile Remove="windows/**" />
    <Content Remove="windows/**" />
    <None Remove="windows/**" />
    <EmbeddedResource Remove="windows/**" />
  </ItemGroup>

</Project>
