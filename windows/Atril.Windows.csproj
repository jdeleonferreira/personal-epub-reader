<Project Sdk="Microsoft.NET.Sdk">

  <!-- Atril for Windows: a WebView2 window published on the Microsoft Store (MSIX).
       Reuses the server and web app of the main project (linked files, not copies).
       The version comes from ../Directory.Build.props -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Atril.Windows</RootNamespace>
    <AssemblyName>Atril</AssemblyName>
    <ApplicationIcon>Assets\atril.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
  </ItemGroup>

  <!-- Code and web app shared with the browser version -->
  <ItemGroup>
    <Compile Include="..\AtrilServer.cs" Link="Shared\AtrilServer.cs" />
    <Compile Include="..\Synology\*.cs" LinkBase="Shared\Synology" />
    <Compile Include="..\Local\*.cs" LinkBase="Shared\Local" />
    <Content Include="..\wwwroot\**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Nothing in the MSIX packaging folder is compiled -->
  <ItemGroup>
    <None Remove="msix\**" />
  </ItemGroup>

</Project>
