<Project Sdk="Microsoft.NET.Sdk">

  <!-- Atril para Windows: ventana con WebView2 que se publica en la Microsoft Store (MSIX).
       Reutiliza el servidor y la app web del proyecto principal (archivos enlazados, no copiados).
       La versión viene de ../Directory.Build.props -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Atril.Windows</RootNamespace>
    <AssemblyName>Atril</AssemblyName>
    <ApplicationIcon>Assets\atril.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
  </ItemGroup>

  <!-- Código y app web compartidos con la versión para navegador -->
  <ItemGroup>
    <Compile Include="..\AtrilServidor.cs" Link="Compartido\AtrilServidor.cs" />
    <Compile Include="..\Synology\*.cs" LinkBase="Compartido\Synology" />
    <Compile Include="..\Local\*.cs" LinkBase="Compartido\Local" />
    <Content Include="..\wwwroot\**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Nada del empaquetado MSIX se compila -->
  <ItemGroup>
    <None Remove="msix\**" />
  </ItemGroup>

</Project>
